<?xml version="1.0" encoding="utf-8"?>
<!-- Esquema del sistema de catálogo. NO MODIFICAR: lo valida un sistema externo. -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="urn:galeria:exposicion:v1"
           xmlns="urn:galeria:exposicion:v1"
           elementFormDefault="qualified">
  <xs:element name="Exposicion">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="Obra" maxOccurs="unbounded" minOccurs="0">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="Titulo" type="xs:string" />
              <xs:element name="Pintor" type="xs:string" />
              <xs:element name="AnchoCm" type="xs:positiveInteger" />
              <xs:element name="Valor" type="xs:decimal" />
            </xs:sequence>
            <xs:attribute name="id" type="xs:int" use="required" />
          </xs:complexType>
        </xs:element>
      </xs:sequence>
      <xs:attribute name="capacidadCm" type="xs:positiveInteger" use="required" />
      <xs:attribute name="valorTotal" type="xs:decimal" use="required" />
    </xs:complexType>
  </xs:element>
</xs:schema>
